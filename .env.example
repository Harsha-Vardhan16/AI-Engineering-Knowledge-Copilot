# EngineeringAI Environment Configuration

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
MCP_PORT=8001

# Local Ollama Configuration (Zero Paid API Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Database Configuration (Defaults to embedded SQLite)
DATABASE_URL=sqlite:///backend/database/engineering_tutor.db

# Vector Index Configuration
FAISS_INDEX_DIMENSION=384
